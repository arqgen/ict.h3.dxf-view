# Ambiente: local | dev | prod
ENVIRONMENT="local"
HOST="0.0.0.0"
PORT=8787

# Provider do LLM: anthropic | openai
LLM_PROVIDER="anthropic"

# Gateway LiteLLM da plataforma. Obrigatória, todo provider fala com ela
PROXY_AI_BASE_URL=""
LITELLM_API_KEY=""

# Anthropic
# Esforço: low | medium | high | xhigh | max. Padrão da API é "high"
ANTHROPIC_MODEL="claude-sonnet-4-6"
ANTHROPIC_MAX_TOKENS=16000
ANTHROPIC_EFFORT="medium"

# OpenAI
OPENAI_MODEL="gpt-5.5"

# Limites de upload e do store de documentos em memória
MAX_UPLOAD_MB=64
MAX_DOCUMENTS=8
DOCUMENT_TTL_SECONDS=7200

# Observabilidade (Arize Phoenix) via OTLP
# Deixe COLLECTOR_ENDPOINT vazio para desligar
COLLECTOR_ENDPOINT="http://localhost:6006"
COLLECTOR_PROJECT_NAME="CAD_VIEWER"
