# Ambiente: local | dev | prod
ENVIRONMENT="local"
HOST="0.0.0.0"
PORT=8787

# Provider do LLM: anthropic | openai
LLM_PROVIDER="anthropic"

# Gateway LiteLLM da plataforma. Obrigatória: todo provider fala com ela e não
# há caminho direto para as APIs nativas. Vazia derruba o startup.
PROXY_AI_BASE_URL=""
LITELLM_API_KEY=""

# Anthropic — id do alias registrado no gateway
ANTHROPIC_MODEL="claude-opus-5"
ANTHROPIC_MAX_TOKENS=16000
# low | medium | high | xhigh | max — default da API é high; medium troca
# profundidade por latência de chat
ANTHROPIC_EFFORT="medium"

# OpenAI — id do alias registrado no gateway
OPENAI_MODEL="gpt-4.1"

# Limites de upload e do store de documentos em memória
MAX_UPLOAD_MB=64
MAX_DOCUMENTS=8
DOCUMENT_TTL_SECONDS=7200

# Observabilidade (Arize Phoenix via OTLP).
# Suba o collector com `make phoenix-up` e acesse a UI em http://localhost:6006.
# Deixe COLLECTOR_ENDPOINT vazio para desligar — não há crash.
COLLECTOR_ENDPOINT="http://localhost:6006"
COLLECTOR_PROJECT_NAME="CAD_VIEWER"
