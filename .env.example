ENVIRONMENT="dev"
HOST="0.0.0.0"
PORT=2222

# Chave compartilhada com a API emissora dos tokens JWT
JWT_SECRET=""
JWT_ALGORITHM="HS256"

OPENAI_API_KEY=""
GOOGLE_API_KEY=""
ANTHROPIC_API_KEY=""
LLAMA_PARSE_API_KEY=""

# MongoDB — conexão explícita por partes (URL montada pelo Settings)
MONGO_DB_HOST=localhost
MONGO_DB_PORT=27017
MONGO_DB_USER=          # deixar vazio em dev sem autenticação
MONGO_DB_PASSWORD=      # deixar vazio em dev sem autenticação
MONGO_DB_DATABASE=h3_kratos

# common-db — somente leitura
COMMON_DB_MONGO_HOST=          # ex: devcluster0.xxxxx.mongodb.net
COMMON_DB_MONGO_USER=
COMMON_DB_MONGO_PASSWORD=
COMMON_DB_MONGO_DATABASE=common-db
COMMON_DB_MONGO_OPTIONS=retryWrites=true&w=majority


COLLECTOR_ENDPOINT="http://localhost:6006"  # docker-compose sobrescreve para http://phoenix:6006
COLLECTOR_PROJECT_NAME="H3_AI_API-KRATOS"

# AWS S3 / MinIO — MinIO em dev local, S3 real em produção
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_PUBLIC_ENDPOINT_URL=
AWS_S3_ACCESS_KEY_ID=minioadmin
AWS_S3_SECRET_ACCESS_KEY=minioadmin
AWS_S3_REGION=us-east-1
AWS_S3_CHAT_FILES_BUCKET="kratos-local-chat-files-bucket"
AWS_S3_FORCE_PATH_STYLE=true
