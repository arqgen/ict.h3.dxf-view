# Ambiente: local | dev | prod
ENVIRONMENT="local"
HOST="0.0.0.0"
PORT=8787

# Provider do LLM: anthropic | openai
LLM_PROVIDER="anthropic"

# Anthropic
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"
ANTHROPIC_MAX_TOKENS=16000
# low | medium | high | xhigh | max — default da API é high; medium troca
# profundidade por latência de chat
ANTHROPIC_EFFORT="medium"

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1"

# Limites de upload e do store de documentos em memória
MAX_UPLOAD_MB=64
MAX_DOCUMENTS=8
DOCUMENT_TTL_SECONDS=7200

# Observabilidade (Arize Phoenix via OTLP).
# Deixe COLLECTOR_ENDPOINT vazio para desligar — não há crash.
COLLECTOR_ENDPOINT=""
COLLECTOR_PROJECT_NAME="CAD_VIEWER"
